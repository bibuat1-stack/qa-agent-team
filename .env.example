# 环境变量模板：复制为 .env 后按需填写。.env 已被 .gitignore 忽略，不要提交。
# 这里只放占位值，不要写入真实的令牌、密码或密钥。
# 优先级：进程环境变量 > .env > config/ 中的默认值。值留空等同于未设置。

# ===== 测试运行：config/environment.py、config/settings.py =====
# 目标环境：dev / test / pre / prod，默认 test。run.py --env 优先于这里的值。
ENVIRONMENT=test
# 接口基础地址，覆盖 config/environment.py 地址表中的值，例如 https://api.example.com。留空使用地址表。
BASE_URL=
# UI 基础地址，覆盖地址表中的值，例如 https://www.example.com。留空使用地址表。
UI_BASE_URL=
# 接口令牌；设置后每个请求都带 Authorization: Bearer <令牌>。
API_TOKEN=
# UI 登录账号；不设置时，使用 ui_credentials fixture 的用例会跳过。
UI_USERNAME=
UI_PASSWORD=
# 请求超时（秒）和连接失败时的重试次数。
TIMEOUT=10
RETRY_TIMES=2
# 日志级别：DEBUG / INFO / WARNING / ERROR。排查问题时设为 DEBUG。
LOG_LEVEL=INFO

# ===== 升级闸门：tools/ask_cursor.py =====
# ask_cursor.py 只读取进程环境变量，不读 .env。在 Bot 云电脑上用 export 设置，
# 或者执行 set -a; . ./.env; set +a 把 .env 导出到当前 shell。
# 账本、brief.md 和 request.json 的保存目录。
ASK_CURSOR_ROOT=/workspace/qa/escalations
# 升级时让 Cloud Agent 使用的强模型 ID；留空表示使用 Cloud Agent 的默认模型。
ASK_CURSOR_MODEL=
# 每天最多升级几次（按北京时间计算）。
ASK_CURSOR_DAILY_BUDGET=3
# Cursor API 密钥，只有 ask_cursor.py api --send 走 REST API 时才需要。
CURSOR_API_KEY=

# ===== GitHub Actions：.github/workflows/regression.yml =====
# CI 不读 .env。下面的值在 GitHub 仓库 Settings > Secrets and variables > Actions 中配置。
# 仓库变量（Variables）：
#   TEST_ENV       对应 ENVIRONMENT，不设置时为 test
#   API_BASE_URL   对应 BASE_URL
#   UI_BASE_URL    对应 UI_BASE_URL
#   TEST_RUNNER    可选，runner 标签，例如 self-hosted；不设置时为 ubuntu-latest
#   NOTIFY_ON_PR   设为 true 时，PR 上的失败也通知 Grok Bot
# 仓库密钥（Secrets）：API_TOKEN、UI_USERNAME、UI_PASSWORD，以及失败通知用的两项：
# GROKBOT_WEBHOOK_URL=
# GROKBOT_WEBHOOK_KEY=

# ===== Bot 云电脑：tools/bootstrap_bot_computer.sh、tools/run_cloud.sh =====
# 这些变量由 shell 读取，不由 pytest 读取。QA_CLOUD=1 时，UI fixture 会加上省资源的浏览器参数。
# QA_ROOT=/workspace/qa
# VENV=$HOME/.venvs/qa
# INSTALL_CURSOR_CLI=0
# QA_INSTALL_GH=0
# QA_KEEP_RUN_DAYS=7
# QA_CLOUD_FORCE_UI=0
# QA_SKIP_BOOTSTRAP=0
